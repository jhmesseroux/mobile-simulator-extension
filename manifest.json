{
  "manifest_version": 3,
  "name": "Mobile Simulator – Responsive Preview",
  "short_name": "Mobile Simulator",
  "version": "6.3.0",
  "description": "Preview any website in realistic phone and tablet frames. Rotate, compare devices, take screenshots and record videos. Free.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Mobile Simulator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "storage",
    "contextMenus",
    "favicon",
    "clipboardWrite",
    "tabCapture",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "frame.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    },
    "open-fullscreen": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open full screen on the current page"
    }
  },
  "side_panel": {
    "default_path": "simulator.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "simulator.html",
        "simulator.css",
        "simulator.js",
        "lib/*",
        "vendor/*",
        "icons/icon32.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
